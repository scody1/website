# Admin Authentication & Security
# The master admin passcode used by /api/admin/verify-pin (defaults to 1234 if unset)
ADMIN_PASSCODE=1234
# Secret salt used for HMAC signing of admin session tokens
ADMIN_SESSION_SECRET=replace_with_a_secure_random_string_in_production

# Courier Gateway Integrations (Optional server-side defaults - can also be configured in Admin Tab 4)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
DELHIVERY_API_TOKEN=
