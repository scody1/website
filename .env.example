# Rajeshwar Pooja Samagri - Environment Variables Configuration
# Copy this file to .env.local for local overrides. (Never commit .env.local or production secrets)

# Cloud Database / Supabase Credentials (Modern Publishable Key standard)
NEXT_PUBLIC_SUPABASE_URL=https://bbqjlkchmelcvjzepjut.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_htaNaZCruAwEH0zYpIyi9w_bsxFouGH

# Server-Side Supabase Secret (Secret Role Key - keep in .env.local or Vercel dashboard)
