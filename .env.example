# Rajeshwar Pooja Samagri - Environment Variables Configuration
# Copy this file to .env.local for local overrides.

# Cloud Database / Supabase Credentials (Optional - can also be configured dynamically in Admin Tab 8)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Shiprocket Courier API Defaults (Optional server-side defaults - can also be configured dynamically in Admin Tab 4)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
