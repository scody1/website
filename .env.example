# =====================================================================
# Rajeshwar Pooja Samagri — environment variables
# Copy to .env.local for local development. In production set these in
# your host's dashboard (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values.
# =====================================================================

# --- Required -------------------------------------------------------
# Postgres connection string. On Supabase use Project Settings → Database →
# Connection string → "Transaction pooler" (port 6543) for Vercel/serverless.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Encrypts the Shiprocket/Razorpay credentials saved in Admin → Integrations.
# A long random string (32+ characters). Never change it after go-live, or the
# saved credentials must be re-entered. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# One-time key needed to create the first Super Admin at /admin (10+ characters).
# After that, everyone signs in with their own email + password.
ADMIN_SETUP_KEY=

# Public site URL (used for webhook URLs shown in the admin), no trailing slash.
SITE_URL=https://www.your-domain.in

# Scheduled jobs (expire unpaid orders, re-sync tracking).
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# --- Optional -------------------------------------------------------
# Shiprocket & Razorpay are normally connected in Admin → Integrations.
# Setting them here instead overrides (and locks) the admin screen.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# DELHIVERY_API_TOKEN=
# DELHIVERY_ENV=production        # or staging
# RESEND_API_KEY=
# EMAIL_FROM=Store <orders@your-domain.in>
# ADMIN_ALERT_EMAIL=owner@example.com

# Used only when a customer gave no email (Shiprocket requires one).
# SHIPROCKET_FALLBACK_EMAIL=orders@your-domain.in

# DB_POOL_MAX=5          # connections per server instance (use 1 with the local PGlite DB)
# DATABASE_SSL=require   # force/disable TLS ("disable" for a local Postgres without TLS)
